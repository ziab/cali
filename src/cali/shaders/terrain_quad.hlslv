#include "cali_common.fx"

/////////////////////////////////////////////////////////////
// Type Definitions
/////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////
// Local functions
/////////////////////////////////////////////////////////////

float3 get_normal_from_heightmap_tex(Texture2D tex, SamplerState samp, float2 uv, float texel_size, float scale_factor)
{
    float h1 = tex.SampleLevel(samp, uv, 0) * scale_factor;
    float h2 = tex.SampleLevel(samp, uv + float2(texel_size, 0.0), 0) * scale_factor;
    float h3 = tex.SampleLevel(samp, uv + float2(texel_size, texel_size), 0) * scale_factor;

    float3 v1 = float3(uv.x, h1, uv.y);
    float3 v2 = float3(uv.x + texel_size, h2, uv.y);
    float3 v3 = float3(uv.x + texel_size, h3, uv.y + texel_size);

    float3 normal = cross(normalize(v3 - v1), normalize(v2 - v1));

    return normal;
}

float3 filter_normal(Texture2D tex, SamplerState samp, float2 uv, float texelSize, float texelAspect)
{
    float4 h;
    h[0] = tex.SampleLevel(samp, uv + texelSize * float2(0, -1), 0).r * texelAspect;
    h[1] = tex.SampleLevel(samp, uv + texelSize * float2(-1, 0), 0).r * texelAspect;
    h[2] = tex.SampleLevel(samp, uv + texelSize * float2(1, 0), 0).r * texelAspect;
    h[3] = tex.SampleLevel(samp, uv + texelSize * float2(0, 1), 0).r * texelAspect;
    float3 n;
    n.z = h[0] - h[3];
    n.x = h[1] - h[2];
    n.y = 2;

    return normalize(n);
}

/////////////////////////////////////////////////////////////////////////////////////
// https://gamedev.stackexchange.com/questions/96459/fast-ray-sphere-collision-code
/////////////////////////////////////////////////////////////////////////////////////
bool intersect_sphere(
    in float3 s, // the start point of the ray
    in float3 d, // a unit vector in the direction of the ray.
    in float3 c, // the center point of the sphere
    in float r, // its radius
    out float3 intersection,
    out float3 normal
)
{
    // Calculate ray start's offset from the sphere center
    float3 p = s - c;

    float r_squared = r * r;
    float p_d = dot(p, d);

    // The sphere is behind or surrounding the start point.
    if (p_d > 0 || dot(p, p) < r_squared)
        return false;

    // Flatten p into the plane passing through c perpendicular to the ray.
    // This gives the closest approach of the ray to the center.
    float3 a = p - p_d * d;

    float a_squared = dot(a, a);

    // Closest approach is outside the sphere.
    if (a_squared > r_squared)
        return false;

    // Calculate distance from plane where ray enters/exits the sphere.    
    float h = sqrt(r_squared - a_squared);

    // Calculate intersection point relative to sphere center.
    float3 i = a - h * d;

    intersection = c + i;
    normal = i / r;
    // We've taken a shortcut here to avoid a second square root.
    // Note numerical errors can make the normal have length slightly different from 1.
    // If you need higher precision, you may need to perform a conventional normalization.

    return true;
}

float2 get_texture_size(Texture2D _texture)
{
    uint tex_width, tex_height;
    _texture.GetDimensions(tex_width, tex_height);
    return float2(tex_width, tex_height);
}

static const float PI = 3.1415926;

/////////////////////////////////////////////////////////////
// Global Resources
/////////////////////////////////////////////////////////////

float4x4 IvModelViewProjectionMatrix;
float4x4 IvNormalMatrix;
float4x4 IvViewProjectionMatrix;
float4x4 IvModelMatrix;

float4x4 rotation_matrix;

Texture2D height_map;
SamplerState height_mapSampler;

float gird_cells;

float3 planet_center;
float planet_radius;
float curvature;
float time;

/*     -  
Z  /       \
|	 A - B
| |  |   |  |
|	 C - D
|	       /
|	   -
.------------X
*/

// 3d sphere surface
float3 quad_a;
float3 quad_b;
float3 quad_c;
float3 quad_d;

// 2d map surface
float3 quad_center;
float3 quad_size;
float quad_scale_factor;
float cube_face;

/////////////////////////////////////////////////////////////
// Main
/////////////////////////////////////////////////////////////

float3 sureface_to_sphere(float phi, float theta, float R, float3 C, out float3 normal)
{
    float cos_theta = cos(theta);

    float3 ps;
    ps.x = cos_theta * sin(phi);
    ps.y = cos_theta * cos(phi);
    ps.z = sin(theta);

    normal = ps;

    return R * ps + C;
}

float3 adjusted_cube_to_sphere(in float2 v, float sphere_radius, float3 sphere_center, out float3 normal)
{
    float phi = v.x * PI / 4.0;
    float theta = atan(tan(PI * v.y / 4.0) * cos(phi));

    return sureface_to_sphere(phi, theta, sphere_radius, sphere_center, normal);
}

float3 rotate_top_to_face(float3 v, float face)
{
    // 0:PosY 1:NegY 2:PosX 3:NegX 4:PosZ 5:NegZ – matches CaliSphereMath.h CubeFace
    int f = (int)face;
    if (f == 0) return v;
    if (f == 1) return float3(v.x, -v.y, -v.z);
    if (f == 2) return float3(v.y, -v.x, v.z);
    if (f == 3) return float3(-v.y, v.x, v.z);
    if (f == 4) return float3(v.x, -v.z, v.y);
    // f == 5
    return float3(v.x, v.z, -v.y);
}

float3 adjusted_cube_to_sphere_face(in float2 v, float sphere_radius, float3 sphere_center, float face, out float3 normal)
{
    float3 local_normal;
    float3 top = adjusted_cube_to_sphere(v, sphere_radius, float3(0,0,0), local_normal);
    float3 rotated = rotate_top_to_face(top, face);
    float3 rot_n = rotate_top_to_face(local_normal, face);
    normal = rot_n;
    return rotated + sphere_center;
}

// ------------------------------------------------------------
// Ocean waves – Gerstner-like sine superposition
// ------------------------------------------------------------
void ocean_basis(float3 N, out float3 Tx, out float3 Tz)
{
    float3 up = abs(N.y) < 0.9 ? float3(0,1,0) : float3(1,0,0);
    Tx = normalize(cross(up, N));
    Tz = cross(N, Tx);
}

float ocean_height_and_slopes(float2 p, float t, out float2 slope)
{
    slope = float2(0,0);
    float h = 0;
    // wave 1
    {
        float2 dir = normalize(float2(0.9, 0.3));
        float k = 0.018;
        float amp = 2.0;
        float speed = 1.1;
        float phase = dot(dir, p) * k - t * speed;
        h += amp * sin(phase);
        float c = amp * k * cos(phase);
        slope += c * dir;
    }
    // wave 2
    {
        float2 dir = normalize(float2(-0.7, 0.6));
        float k = 0.032;
        float amp = 1.1;
        float speed = 0.9;
        float phase = dot(dir, p) * k - t * speed;
        h += amp * sin(phase);
        float c = amp * k * cos(phase);
        slope += c * dir;
    }
    // wave 3
    {
        float2 dir = normalize(float2(0.3, -0.8));
        float k = 0.05;
        float amp = 0.6;
        float speed = 1.4;
        float phase = dot(dir, p) * k - t * speed;
        h += amp * sin(phase);
        float c = amp * k * cos(phase);
        slope += c * dir;
    }
    // small ripples
    {
        float2 dir = normalize(float2(0.6, 0.6));
        float k = 0.09;
        float amp = 0.25;
        float speed = 2.2;
        float phase = dot(dir, p) * k - t * speed;
        h += amp * sin(phase);
        float c = amp * k * cos(phase);
        slope += c * dir;
    }
    return h;
}

float4x4 calc_rotation_matrix(in float3 axis, float angle)
{
    float c, s;
    sincos(angle, s, c);
    float t = 1.0f - c;

    float3 nAxis = normalize(axis);

    // intermediate values
    float tx = t * nAxis.x;
    float ty = t * nAxis.y;
    float tz = t * nAxis.z;
    float sx = s * nAxis.x;
    float sy = s * nAxis.y;
    float sz = s * nAxis.z;
    float txy = tx * nAxis.y;
    float tyz = ty * nAxis.z;
    float txz = tx * nAxis.z;

    // set matrix
    float4x4 mv;

    // set matrix
    mv._11 = tx * nAxis.x + c;
    mv._21 = txy - sz;
    mv._31 = txz + sy;
    mv._41 = 0.0f;

    mv._12 = txy + sz;
    mv._22 = ty * nAxis.y + c;
    mv._32 = tyz - sx;
    mv._42 = 0.0f;

    mv._13 = txz - sy;
    mv._23 = tyz + sx;
    mv._33 = tz * nAxis.z + c;
    mv._43 = 0.0f;

    mv._14 = 0.0f;
    mv._24 = 0.0f;
    mv._34 = 0.0f;
    mv._44 = 1.0f;

    return mv;

} // End of IvMatrix33::Rotation()

TERRAIN_VS_OUTPUT main(float2 uv : TEXCOORD, float3 normal : NORMAL, float4 position : POSITION)
{
    TERRAIN_VS_OUTPUT output;

    ///////////////////////////////////////////////
    // calculate grid parameters

    float2 quad_center_uv = float2(quad_center.x, quad_center.y) / (planet_radius * 2.0) + float2(0.5, 0.5);
    float quad_size_relative = quad_size.x / (planet_radius * 2.0);

    float2 translated_uv = (quad_center_uv + uv * quad_size_relative) * quad_scale_factor;

    // loop the texture
    translated_uv = frac(abs(translated_uv));

    ///////////////////////////////////////////////
    //

    float3 world_normal, world_position_inter;

    if (curvature != 0.0)
    {
        float2 surface_point = (float2(quad_center.x, quad_center.y) + uv * quad_size.x) / planet_radius;
        world_position_inter = adjusted_cube_to_sphere_face(surface_point, planet_radius, planet_center, cube_face, world_normal);
    }
    else
    {
        world_position_inter = quad_lerp(quad_a, quad_b, quad_c, quad_d, float2(uv.x + 0.5, 1.0 - (uv.y + 0.5)));
        world_normal = normalize(world_position_inter - planet_center);
    }

    float height = sqrt(height_map.SampleLevel(height_mapSampler, translated_uv, 0).r) * 1500.0 * 0.1;
    bool isOcean = height < 2.0;

    float3 finalNormal;
    float4 world_position;

    if (isOcean)
    {
        // ocean waves in tangent plane
        float3 Tx, Tz;
        ocean_basis(world_normal, Tx, Tz);
        float3 localPos = world_position_inter - planet_center;
        float2 waveP = float2(dot(localPos, Tx), dot(localPos, Tz));
        float2 slope;
        float waveH = ocean_height_and_slopes(waveP, time, slope);
        // fade near shore to avoid discontinuity
        float shoreBlend = saturate((2.0 - height) / 1.0);
        waveH *= shoreBlend;
        slope *= shoreBlend * 0.6;
        float3 waveNormal = normalize(world_normal - slope.x * Tx - slope.y * Tz);
        finalNormal = waveNormal;
        // keep ocean at sea level + wave
        float finalHeight = waveH;
        world_position = float4(world_position_inter + world_normal * finalHeight, 1.0);
        // preserve water tag for PS (height <2) – store wave height but keep below threshold
        height = finalHeight * 0.5 + 0.5; // remap to ~0-1 range stays <2
        // small foam hint could be encoded in height variation but keep simple
    }
    else
    {
        float angle = acos(dot(world_normal, float3(0.0, 1.0, 0.0)));
        float3 tangent = cross(world_normal, float3(0.0, 1.0, 0.0));
        float4x4 normal_rot_mat = calc_rotation_matrix(tangent, angle);
        finalNormal = (float3) mul(normal_rot_mat,
            float4(get_normal_from_heightmap_tex(height_map, height_mapSampler, translated_uv, quad_size_relative.x / gird_cells, 1.0), 0.0)
        );
        world_position = float4(world_position_inter + world_normal * height, 1.0);
    }

    output.screen_position = mul(IvViewProjectionMatrix, world_position);
    output.world_position = world_position;
    output.normal = finalNormal;
    output.height = height;

    return output;
}
